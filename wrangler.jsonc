{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "franciscosolis",
  "compatibility_date": "2026-07-29",
  "main": "src/worker/index.ts",
  "cache": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "franciscosolis.cl",
      "zone_name": "franciscosolis.cl",
      "custom_domain": true
    }
  ],
  "placement": {
    "mode": "smart"
  },
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.5,
    "logs": {
      "enabled": false,
      "invocation_logs": false
    }
  }
}