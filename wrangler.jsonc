{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "franciscosolis",
  "compatibility_date": "2026-07-29",
  "preview_urls": true,
  "workers_dev": true,
  "cache": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "franciscosolis.cl",
      "zone_name": "franciscosolis.cl",
      "custom_domain": true
    }
  ],
  "placement": {
    "mode": "smart"
  },
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.25,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 0.25
    }
  }
}