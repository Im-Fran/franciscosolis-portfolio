# Auth service the /auth interface talks to. Defaults to the production issuer when unset.
VITE_AUTH_BASE_URL=https://api.franciscosolis.cl/auth

# Client ID this site is registered under. The application must exist on the auth service with
# <origin>/auth/callback among its redirect URIs — for local work that is
# http://localhost:5173/auth/callback.
VITE_AUTH_CLIENT_ID=franciscosolis-web
