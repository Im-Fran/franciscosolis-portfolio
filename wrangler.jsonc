{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "franciscosolis",
  "compatibility_date": "2026-07-29",
  "main": "src/worker/index.ts",
  "preview_urls": true,
  "workers_dev": true,
  "cache": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "franciscosolis.cl",
      "zone_name": "franciscosolis.cl",
      "custom_domain": true
    }
  ],
  "placement": {
    "mode": "smart"
  },
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "franciscosolis",
      "database_id": "60e6aee6-cac0-4b61-beb1-48e675a8ad1f"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "franciscosolis"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.25,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 0.25
    }
  }
}